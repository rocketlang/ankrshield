# pnpm workspace configuration
enable-pre-post-scripts=true

# Approve build scripts for native modules and tools
approved-builds=@prisma/client,@prisma/engines,electron,electron-winstaller,esbuild,ffi-napi,msgpackr-extract,prisma,ref-napi

# Expo/React-Native need hoisted node_modules — Metro autolinking + @expo/metro-config
# resolve these from a flat layout (pnpm strict isolation breaks it: chalk, expo-asset, ...).
# Surgical (only these patterns hoist; rest of the monorepo stays isolated). EAS honors this.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=metro*
public-hoist-pattern[]=@react-navigation/*
