# Database
DATABASE_URL="postgresql://ankrshield:ankrshield_dev_password@localhost:5432/ankrshield?schema=public"
DATABASE_TEST_URL="postgresql://ankrshield:ankrshield_test_password@localhost:5433/ankrshield_test?schema=public"

# Redis
REDIS_URL="redis://:ankrshield_redis_password@localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="24h"
REFRESH_TOKEN_EXPIRES_IN="30d"

# API
API_PORT=4000
API_HOST="0.0.0.0"
NODE_ENV="development"

# Web Dashboard
WEB_PORT=3000
WEB_HOST="0.0.0.0"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1m"

# DNS
DNS_UPSTREAM="https://cloudflare-dns.com/dns-query"
DNS_CACHE_TTL=300

# VPN (WireGuard)
VPN_ENDPOINT="vpn.ankrshield.com:51820"
VPN_PRIVATE_KEY=""
VPN_PUBLIC_KEY=""

# Stripe (for payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (for notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@ankrshield.com"

# Monitoring
SENTRY_DSN=""
LOG_LEVEL="info"

# Feature Flags (for development)
FEATURE_AI_MONITORING="true"
FEATURE_SPYWARE_DETECTION="true"
FEATURE_IDENTITY_PROTECTION="false"

# AI Warrior — LLM-powered threat engine
ANTHROPIC_API_KEY="sk-ant-..."
WARRIOR_MODEL="claude-sonnet-4-6"
WARRIOR_CORRELATION_WINDOW_MS="300000"   # 5 minutes
WARRIOR_THREAT_THRESHOLD="55"           # min score to trigger policy gen
WARRIOR_AUTO_QUARANTINE_SCORE="88"      # auto-quarantine above this
WARRIOR_ENABLE_HONEYPOTS="true"
WARRIOR_REPORT_INTERVAL_MS="86400000"   # 24 hours
WARRIOR_SPYWARE_SCAN_INTERVAL_MS="21600000"  # 6 hours
DEFAULT_WORKSPACE_ROOT=""               # e.g. /home/user/projects

# AnkrWire — event bus for push notifications
ANKR_WIRE_WS_URL="http://localhost:4007"
ANKR_WIRE_URL="http://localhost:4007"
ANKR_WIRE_WHATSAPP="true"
ANKR_WIRE_TELEGRAM="true"
