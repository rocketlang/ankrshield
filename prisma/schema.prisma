// ankrshield Prisma Schema
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch", "views"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp"), pgcrypto, pg_trgm, btree_gin, btree_gist]
  // timescaledb and vector extensions will be added when Docker setup is complete
}

// ============================================================================
// ENUMS
// ============================================================================

enum SubscriptionTier {
  FREE
  FREEMIUM
  PREMIUM
  PRO
  FAMILY
  ENTERPRISE
  SUPER

  @@map("subscription_tier")
}

enum DeviceType {
  WINDOWS
  MACOS
  LINUX
  IOS
  ANDROID
  BROWSER
  GATEWAY

  @@map("device_type")
}

enum ThreatLevel {
  SAFE
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("threat_level")
}

enum AIAgentType {
  CHATGPT
  CLAUDE
  COPILOT
  GEMINI
  MIDJOURNEY
  ELEVENLABS
  OTHER

  @@map("ai_agent_type")
}

enum PolicyAction {
  ALLOW
  BLOCK
  NOTIFY
  PROMPT

  @@map("policy_action")
}

enum TrackerCategory {
  ADVERTISING
  ANALYTICS
  SOCIAL_MEDIA
  TELEMETRY
  MALWARE
  CDN
  FINGERPRINTING
  CRYPTOMINING
  OTHER
}

enum EventType {
  DNS_QUERY
  DNS_BLOCKED
  NETWORK_REQUEST
  NETWORK_BLOCKED
  AI_FILE_ACCESS
  AI_CLIPBOARD
  AI_NETWORK
  AI_BLOCKED
  POLICY_VIOLATION
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email     String   @unique
  name      String?
  password  String // hashed with bcrypt
  emailVerified DateTime?

  // Subscription
  tier      SubscriptionTier @default(FREE)
  stripeCustomerId String? @unique
  stripeSubscriptionId String?
  subscriptionExpiresAt DateTime?

  // Settings
  privacyLevel  Int @default(5) @db.SmallInt // 1-10 scale
  enabledFeatures Json @default("{}")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?

  // Relations
  sessions     Session[]
  devices      Device[]
  policies     Policy[]
  privacyScores PrivacyScore[]
  alerts       Alert[]
  apiKeys      ApiKey[]
  integrations UserIntegration[]

  @@index([email])
  @@index([tier])
  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  refreshToken String? @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// DEVICES
// ============================================================================

model Device {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  name      String // User-assigned name like "John's MacBook"
  deviceType DeviceType

  // Device identification
  hostname  String?
  macAddress String?
  ipAddress String?

  // Device info
  osVersion String?
  appVersion String?

  // Status
  isActive  Boolean @default(true)
  lastSeenAt DateTime @default(now())

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  networkEvents NetworkEvent[]
  aiActivities AIActivity[]

  @@index([userId])
  @@index([deviceType])
  @@index([isActive])
  @@index([lastSeenAt])
  @@map("devices")
}

// ============================================================================
// NETWORK MONITORING (Time-Series)
// ============================================================================

// This will be converted to a TimescaleDB hypertable
model NetworkEvent {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  timestamp DateTime @default(now()) @db.Timestamptz

  // Device info
  deviceId  String   @db.Uuid
  userId    String   @db.Uuid

  // Event details
  eventType EventType
  domain    String
  ip        String?
  port      Int?     @db.SmallInt
  protocol  String?  // HTTP, HTTPS, DNS, QUIC, etc.

  // Classification
  trackerId String?  @db.Uuid
  isBlocked Boolean  @default(false)
  blockedBy String?  // "policy", "blocklist", "ai"

  // Network details
  bytesIn   Int      @default(0)
  bytesOut  Int      @default(0)
  duration  Int?     // milliseconds

  // Metadata
  processName String?
  processPath String?
  sni       String?  // TLS SNI

  // Relations
  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tracker   Tracker? @relation(fields: [trackerId], references: [id])

  @@index([timestamp(sort: Desc)]) // Critical for time-series queries
  @@index([deviceId, timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@index([domain])
  @@index([trackerId])
  @@index([isBlocked])
  @@index([eventType])
  @@map("network_events")
}

// ============================================================================
// TRACKERS & BLOCKLISTS
// ============================================================================

model Tracker {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  domain    String   @unique

  // Classification
  category  TrackerCategory
  vendor    String?  // "Google", "Facebook", "Amazon", etc.
  threatLevel ThreatLevel @default(MEDIUM)

  // Metadata
  description String?
  sources   String[] // Which blocklists include this tracker

  // Statistics (denormalized for performance)
  blockedCount Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  // Relations
  networkEvents NetworkEvent[]

  @@index([domain])
  @@index([category])
  @@index([vendor])
  @@index([threatLevel])
  @@map("trackers")
}

// ============================================================================
// POLICIES
// ============================================================================

model Policy {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  name      String
  description String?

  // Policy configuration
  isEnabled Boolean  @default(true)
  priority  Int      @default(0) @db.SmallInt // Higher priority = executes first

  // Conditions (JSON for flexibility)
  conditions Json // { "domains": ["*.facebook.com"], "categories": ["ADVERTISING"], "threatLevel": "HIGH" }

  // Actions
  action    PolicyAction
  notifyUser Boolean @default(false)
  logEvent  Boolean  @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isEnabled])
  @@index([priority])
  @@map("policies")
}

// ============================================================================
// AI AGENT MONITORING
// ============================================================================

model AIAgent {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String
  agentType AIAgentType

  // Identification
  processNames String[] // Patterns to match processes
  domains   String[]  // Domains this agent connects to
  executablePaths String[] // Executable file paths

  // Metadata
  vendor    String?
  version   String?
  description String?

  // Status
  isVerified Boolean @default(false) // Verified by ankrshield team
  isActive  Boolean @default(true)

  // Risk assessment
  riskScore Int @default(50) @db.SmallInt // 0-100

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime?

  // Relations
  activities AIActivity[]

  @@index([agentType])
  @@index([isVerified])
  @@index([isActive])
  @@index([riskScore])
  @@map("ai_agents")
}

model AIActivity {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  timestamp DateTime @default(now()) @db.Timestamptz

  // Agent info
  agentId   String   @db.Uuid
  deviceId  String   @db.Uuid

  // Activity details
  activityType String // "FILE_READ", "FILE_WRITE", "CLIPBOARD", "NETWORK", etc.
  resource  String?  // File path, URL, clipboard content hash

  // Classification
  isBlocked Boolean  @default(false)
  blockedReason String?

  // Metadata
  metadata  Json?

  // Relations
  agent     AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([timestamp(sort: Desc)])
  @@index([agentId, timestamp(sort: Desc)])
  @@index([deviceId, timestamp(sort: Desc)])
  @@index([activityType])
  @@index([isBlocked])
  @@map("ai_activities")
}

// ============================================================================
// PRIVACY SCORING (Aggregated Metrics)
// ============================================================================

model PrivacyScore {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  timestamp DateTime @default(now()) @db.Timestamptz

  // Overall score (0-100)
  overallScore Int @db.SmallInt

  // Component scores
  networkScore Int @db.SmallInt
  dnsScore    Int @db.SmallInt
  appScore    Int @db.SmallInt
  aiScore     Int @db.SmallInt

  // Statistics (for the time period)
  totalRequests Int @default(0)
  blockedRequests Int @default(0)
  allowedRequests Int @default(0)
  trackersBlocked Int @default(0)

  // Comparison
  previousScore Int? @db.SmallInt
  scoreChange Int? @db.SmallInt

  // Period type
  period    String @default("daily") // "hourly", "daily", "weekly", "monthly"

  // Relations
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp(sort: Desc)])
  @@index([period])
  @@map("privacy_scores")
}

// ============================================================================
// ALERTS & NOTIFICATIONS
// ============================================================================

model Alert {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  timestamp DateTime @default(now())

  // Alert details
  severity  AlertSeverity
  title     String
  message   String
  category  String // "PRIVACY_BREACH", "HIGH_RISK_TRACKER", "AI_SUSPICIOUS", etc.

  // Status
  isRead    Boolean @default(false)
  isDismissed Boolean @default(false)

  // Metadata
  metadata  Json?
  actionUrl String?

  // Relations
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp(sort: Desc)])
  @@index([severity])
  @@index([isRead])
  @@map("alerts")
}

// ============================================================================
// AI WARRIOR — Threat Intelligence Persistence
// ============================================================================

enum WarriorAttackType {
  data_exfiltration
  credential_theft
  lateral_movement
  ransomware
  surveillance
  supply_chain_compromise
  privilege_escalation
  honeypot_triggered
  unknown

  @@map("warrior_attack_type")
}

enum WarriorEventType {
  attack_detected
  policy_generated
  honeypot_triggered
  agent_quarantined
  scope_violation
  incident_report
  spyware_detected

  @@map("warrior_event_type")
}

// Correlated attack chains detected by AI Warrior
model WarriorAttackChain {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  detectedAt    DateTime @default(now()) @db.Timestamptz
  startTime     DateTime @db.Timestamptz
  endTime       DateTime @db.Timestamptz

  // Classification
  attackType    WarriorAttackType
  threatScore   Float    @db.Real      // 0-100
  eventCount    Int      @default(0)

  // LLM-generated text
  narrative         String   @db.Text
  technicalSummary  String   @db.Text

  // JSON arrays
  affectedAssets    String[]
  suggestedActions  String[]
  autoActionsApplied String[]

  // Relations
  policies      WarriorPolicy[]
  events        WarriorEvent[]

  @@index([detectedAt(sort: Desc)])
  @@index([attackType])
  @@index([threatScore(sort: Desc)])
  @@map("warrior_attack_chains")
}

// Auto-generated policies from attack chains
model WarriorPolicy {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  createdAt       DateTime @default(now())

  name            String
  description     String   @db.Text
  triggeredBy     String   @db.Uuid     // WarriorAttackChain.id
  confidence      Float    @db.Real     // 0-100
  autoApplied     Boolean  @default(false)
  requiresApproval Boolean @default(true)
  appliedAt       DateTime?

  // Rules stored as JSON array of { type, value, reason }
  rules           Json

  // Relation
  chain           WarriorAttackChain @relation(fields: [triggeredBy], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([requiresApproval])
  @@index([autoApplied])
  @@map("warrior_policies")
}

// Persisted incident reports (LLM-generated, immutable after creation)
model WarriorIncidentReport {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  generatedAt     DateTime @default(now())
  periodStart     DateTime @db.Timestamptz
  periodEnd       DateTime @db.Timestamptz

  riskScore       Float    @db.Real
  executiveSummary String  @db.Text
  technicalAnalysis String @db.Text

  totalEventsAnalyzed   Int @default(0)
  totalAlertsGenerated  Int @default(0)

  // JSON arrays / objects
  topThreats      String[]
  recommendations String[]
  // Full report stored as JSON for complete replay
  rawReport       Json

  @@index([generatedAt(sort: Desc)])
  @@index([riskScore(sort: Desc)])
  @@map("warrior_incident_reports")
}

// Append-only event log — every significant warrior action
model WarriorEvent {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  occurredAt  DateTime @default(now()) @db.Timestamptz

  eventType   WarriorEventType
  agentId     String?
  agentName   String?
  chainId     String?  @db.Uuid

  // Serialised payload (AttackChain, ScopeViolation, etc.)
  payload     Json

  // Optional relation to chain
  chain       WarriorAttackChain? @relation(fields: [chainId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)])
  @@index([eventType])
  @@index([agentId])
  @@index([chainId])
  @@map("warrior_events")
}

// Quarantine registry — persists across restarts
model WarriorQuarantine {
  agentId       String   @id
  agentName     String
  quarantinedAt DateTime @default(now())
  reason        String   @db.Text
  attackChainId String   @db.Uuid
  isActive      Boolean  @default(true)
  releasedAt    DateTime?

  @@index([isActive])
  @@index([quarantinedAt(sort: Desc)])
  @@map("warrior_quarantine")
}

// ============================================================================
// DOMAIN WATCH (Continuous monitoring + alerting)
// ============================================================================

// Domains under continuous 5-minute surveillance
model DomainWatch {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String?   @db.Uuid   // null = system-added; set for user-owned watches
  domain         String    @unique
  webhookUrl     String?   // POST alert payloads here on change
  isActive       Boolean   @default(true)

  // Last scan snapshot (used for delta detection)
  lastCheckedAt  DateTime?
  lastRiskScore  Int?      @db.SmallInt
  lastRiskLevel  String?

  // Counts
  alertCount     Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  alerts         AlertHistory[]

  @@index([isActive])
  @@index([domain])
  @@index([userId])
  @@map("domain_watches")
}

// Alert history — one row per change detected
model AlertHistory {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  watchId       String      @db.Uuid
  watch         DomainWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  triggeredAt   DateTime    @default(now())

  // e.g. "score_change", "new_typosquat", "spf_removed", "dmarc_removed",
  //      "phishing_found", "ip_threat", "new_breach"
  alertType     String
  previousValue String?
  newValue      String?

  // Webhook delivery status: "sent" | "failed" | "skipped"
  webhookStatus String?

  @@index([watchId])
  @@index([triggeredAt(sort: Desc)])
  @@map("alert_history")
}

// ============================================================================
// USER INTEGRATIONS (Slack, WhatsApp, Telegram, Jira, PagerDuty…)
// ============================================================================

// One row per integration per user. provider is a lowercase slug: "slack", "telegram", etc.
model UserIntegration {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @db.Uuid
  provider    String   // "slack" | "telegram" | "whatsapp" | "jira" | "pagerduty"

  // Provider-specific config stored as JSON
  // Slack:      { webhookUrl: "https://hooks.slack.com/services/..." }
  // Telegram:   { botToken: "...", chatId: "..." }
  // Jira:       { url: "...", token: "...", projectKey: "..." }
  // PagerDuty:  { routingKey: "..." }
  config      Json

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@map("user_integrations")
}

// ============================================================================
// API KEY MANAGEMENT
// ============================================================================

enum ApiKeyTier {
  FREE      // 10 req/month (unauthenticated IP-based)
  STARTER   // 500 req/month
  PRO       // unlimited

  @@map("api_key_tier")
}

// API keys for programmatic access to the risk/scan endpoints
model ApiKey {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String     @db.Uuid
  name        String     // user-assigned label, e.g. "CI Scanner"
  prefix      String     @db.Char(8)   // first 8 chars — shown in UI for identification
  hash        String     @unique       // SHA-256 of the full key — never stored raw
  tier        ApiKeyTier @default(STARTER)

  // Usage tracking
  monthlyRequestCount Int      @default(0)
  lastUsedAt          DateTime?

  // Lifecycle
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hash])
  @@index([prefix])
  @@index([isActive])
  @@map("api_keys")
}

// ============================================================================
// ANALYTICS (Denormalized for performance)
// ============================================================================

// This model is for pre-computed analytics
model DailyStats {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  date      DateTime @db.Date

  // Request stats
  totalRequests Int @default(0)
  blockedRequests Int @default(0)
  dnsQueries   Int @default(0)
  dnsBlocked   Int @default(0)

  // Tracker stats
  uniqueTrackers Int @default(0)
  trackersBlocked Int @default(0)
  topTracker   String?
  topCategory  String?

  // Device stats
  activeDevices Int @default(0)

  // AI stats
  aiActivities Int @default(0)
  aiBlocked   Int @default(0)

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
  @@map("daily_stats")
}

// ============================================================================
// XSHIELD — B2B Digital Risk Protection
// ============================================================================

enum XShieldTier {
  FREE
  STARTER
  PRO
  ENTERPRISE

  @@map("xshield_tier")
}

enum RiskLevel {
  MINIMAL
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("risk_level")
}

enum WatchStatus {
  ACTIVE
  PAUSED
  DELETED

  @@map("watch_status")
}

model XShieldApiKey {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  keyHash     String   @unique // sha256 of the actual key
  keyPrefix   String   // first 8 chars for display (e.g. "xsk_live")
  name        String   // user-assigned label
  orgName     String?
  email       String

  tier        XShieldTier @default(FREE)
  monthlyQuota Int @default(10) // reports/month
  usedThisMonth Int @default(0)
  quotaResetAt  DateTime

  // Stripe billing
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?

  isActive    Boolean @default(true)
  lastUsedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  watches     XShieldDomainWatch[]
  riskReports XShieldRiskReport[]

  @@index([keyHash])
  @@index([email])
  @@index([tier])
  @@index([stripeCustomerId])
  @@map("xshield_api_keys")
}

model XShieldDomainWatch {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  apiKeyId    String   @db.Uuid
  domain      String

  // Latest scan result
  lastRiskScore  Int?    @db.SmallInt
  lastRiskLevel  RiskLevel?
  lastScannedAt  DateTime?

  // Watch config
  status      WatchStatus @default(ACTIVE)
  alertThreshold Int @default(40) @db.SmallInt // alert when score >= this
  webhookUrl  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiKey      XShieldApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  alerts      WatchAlert[]

  @@unique([apiKeyId, domain])
  @@index([apiKeyId])
  @@index([domain])
  @@index([status])
  @@index([lastScannedAt])
  @@map("xshield_domain_watches")
}

model WatchAlert {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  watchId     String   @db.Uuid
  domain      String
  riskScore   Int      @db.SmallInt
  riskLevel   RiskLevel
  triggeredAt DateTime @default(now())
  details     Json?    // snapshot of risk report at alert time
  notified    Boolean  @default(false)
  notifiedAt  DateTime?

  watch       XShieldDomainWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId])
  @@index([triggeredAt(sort: Desc)])
  @@map("watch_alerts")
}

model XShieldRiskReport {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  apiKeyId    String?  @db.Uuid  // null for public/anonymous
  domain      String
  riskScore   Int      @db.SmallInt
  riskLevel   RiskLevel
  findings    Json     // full structured report
  mitreMapping Json?   // ATT&CK technique mappings
  createdAt   DateTime @default(now())

  apiKey      XShieldApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([domain, createdAt(sort: Desc)])
  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([riskLevel])
  @@map("xshield_risk_reports")
}
