{
  "name": "@ankrshield/ui",
  "version": "0.1.0",
  "description": "Shared UI components for ankrshield",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "react": "^19.0.0",
    "lucide-react": "^0.312.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
