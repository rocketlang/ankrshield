{
  "name": "@ankrshield/network-monitor",
  "version": "0.1.0",
  "description": "Cross-platform network traffic monitoring with app attribution and privacy analysis",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./src/index.ts",
      "types": "./dist/index.d.ts"
    },
    "./src": "./src/index.ts",
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsx scripts/run-tests.ts",
    "test:capture": "tsx scripts/test-capture.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "network",
    "monitoring",
    "privacy",
    "packet-capture",
    "traffic-analysis",
    "sni-extraction",
    "cross-platform"
  ],
  "dependencies": {
    "@ankrshield/core": "workspace:*",
    "@ankrshield/dns-resolver": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bull": "^4.12.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.9.3",
    "vitest": "^1.2.0",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0"
  },
  "optionalDependencies": {
    "node-libpcap": "^0.9.3",
    "ffi-napi": "^4.0.3",
    "ref-napi": "^3.0.3",
    "pcap-parser": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ]
}
