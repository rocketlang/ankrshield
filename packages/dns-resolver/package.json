{
  "name": "@ankrshield/dns-resolver",
  "version": "0.1.0",
  "description": "DNS-over-HTTPS resolver with blocklist support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ankr-dns": "./bin/ankr-dns.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ankrshield/core": "workspace:*",
    "@ankrshield/tracker-db": "workspace:*",
    "bloom-filters": "^3.0.4",
    "bull": "^4.16.5",
    "commander": "^14.0.2",
    "ioredis": "^5.3.2",
    "trie-search": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.9.3",
    "vitest": "^1.2.0"
  }
}
