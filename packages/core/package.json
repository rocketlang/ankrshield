{
  "name": "@ankrshield/core",
  "version": "0.1.0",
  "description": "Core utilities and shared types for ankrshield",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ioredis": "^5.9.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.9.3",
    "vitest": "^1.2.0"
  }
}
