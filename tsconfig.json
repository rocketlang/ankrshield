{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "paths": {
      "@ankrshield/core": ["./packages/core/src"],
      "@ankrshield/api-client": ["./packages/api-client/src"],
      "@ankrshield/ui": ["./packages/ui/src"],
      "@ankrshield/config": ["./packages/config/src"],
      "@ankrshield/dns-resolver": ["./packages/dns-resolver/src"],
      "@ankrshield/network-monitor": ["./packages/network-monitor/src"],
      "@ankrshield/privacy-engine": ["./packages/privacy-engine/src"],
      "@ankrshield/policy-engine": ["./packages/policy-engine/src"],
      "@ankrshield/ai-governance": ["./packages/ai-governance/src"],
      "@ankrshield/ai-warrior": ["./packages/ai-warrior/src"],
      "@ankrshield/spyware-detector": ["./packages/spyware-detector/src"],
      "@ankrshield/android-monitor": ["./packages/android-monitor/src"],
      "@ankrshield/risk-intelligence": ["./packages/risk-intelligence/src"],
      "@ankrshield/tracker-db": ["./packages/tracker-db/src"],
      "@ankrshield/crypto": ["./packages/crypto/src"],
      "@ankrshield/sms-shield": ["./packages/sms-shield/src"],
      "@ankrshield/dpdp-scanner": ["./packages/dpdp-scanner/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "out"]
}
