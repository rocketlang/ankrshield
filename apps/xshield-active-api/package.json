{
  "name": "@ankrshield/xshield-active-api",
  "version": "0.1.0",
  "private": true,
  "description": "xShield Active Defense — standalone SIEM connector + active defense service",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --noEmitOnError false || true",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@ankrshield/ai-warrior": "workspace:*",
    "@ankrshield/risk-intelligence": "workspace:*",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "zod": "^3.22.4",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.4.2"
  }
}
