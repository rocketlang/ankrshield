{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@ankrshield/core": ["../../packages/core/src"],
      "@ankrshield/config": ["../../packages/config/src"]
    },
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/main.ts", "src/preload.ts", "src/main/**/*", "src/preload/**/*"],
  "exclude": ["src/renderer/**/*", "node_modules", "dist"],
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/config" }]
}
