# AnkrShield Desktop Application Configuration

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# PostgreSQL connection string or SQLite file path
# PostgreSQL example: postgresql://user:password@localhost:5432/ankrshield
# SQLite example: file:./ankrshield.db (default if not specified)
DATABASE_URL="postgresql://localhost:5432/ankrshield"

# ============================================
# Redis Configuration (OPTIONAL)
# ============================================
# Redis connection URL for caching
# If not provided, app will continue without caching
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=true

# ============================================
# Environment
# ============================================
NODE_ENV="development"
# Options: development, production, test

# ============================================
# Logging
# ============================================
LOG_LEVEL="debug"
# Options: debug, info, warn, error

# ============================================
# Feature Flags
# ============================================
# Enable/disable network monitoring (requires permissions)
ENABLE_NETWORK_MONITOR=true

# Enable/disable DNS resolver
ENABLE_DNS_RESOLVER=true

# Enable/disable AI agent monitoring
ENABLE_AI_MONITORING=true

# ============================================
# Performance Tuning
# ============================================
# Batch size for database writes
BATCH_SIZE=100

# Flush interval in milliseconds
FLUSH_INTERVAL=5000

# ============================================
# macOS Code Signing (Production Only)
# ============================================
# Required for distributing signed macOS builds
# APPLE_ID=your-email@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX

# ============================================
# Windows Code Signing (Production Only)
# ============================================
# Required for distributing signed Windows builds
# WINDOWS_CERTIFICATE_FILE=./cert.pfx
# WINDOWS_CERTIFICATE_PASSWORD=your-certificate-password
