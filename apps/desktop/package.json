{
  "name": "@ankrshield/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy protection for your digital life - FREE tier desktop app",
  "author": {
    "name": "xShieldAI Team",
    "email": "hello@xshieldai.com",
    "url": "https://xshieldai.com"
  },
  "homepage": "https://xshieldai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankrshield/ankrshield"
  },
  "license": "AGPL-3.0-only",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron-forge start\"",
    "dev:renderer": "vite",
    "dev:main": "electron-forge start",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc",
    "start": "electron-forge start",
    "package": "npm run build && electron-builder --dir",
    "make": "npm run build && electron-builder",
    "make:win": "npm run build && electron-builder --win",
    "make:mac": "npm run build && electron-builder --mac",
    "make:linux": "npm run build && electron-builder --linux",
    "make:all": "npm run build && electron-builder -mwl",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf dist out"
  },
  "dependencies": {
    "@ankrshield/dns-resolver": "workspace:*",
    "@ankrshield/network-monitor": "workspace:*",
    "@ankrshield/privacy-engine": "workspace:*",
    "@napi-rs/keyring": "^1.3.0",
    "@prisma/client": "^5.22.0",
    "@vscode/sudo-prompt": "^9.3.2",
    "@xshieldai/aegis": "^2.2.0",
    "electron-squirrel-startup": "^1.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.1.7",
    "ioredis": "^5.3.2",
    "node-forge": "^1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@types/node": "^20.11.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "electron": "^28.1.4",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.0.10",
    "vitest": "^1.2.0"
  }
}
