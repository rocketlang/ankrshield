<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AnkrShield</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.3.3</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>133</string>
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Deep link: ankrshield:// -->
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.ankr.shield</string>
				<string>ankrshield</string>
			</array>
		</dict>
	</array>

	<!-- Privacy usage descriptions — required for App Store review -->
	<key>NSCameraUsageDescription</key>
	<string>AnkrShield uses the camera to scan QR codes for MDM enrollment.</string>
	<key>NSContactsUsageDescription</key>
	<string>AnkrShield checks contact names against known scam patterns to detect WhatsApp impersonation.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AnkrShield records your last-known location for anti-theft recovery (stored on-device only).</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AnkrShield monitors local network DNS queries to block trackers and phishing domains.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>AnkrShield uses Face ID to protect access to sensitive security settings.</string>

	<!-- Background modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>network-authentication</string>
		<string>processing</string>
	</array>

	<!-- App Transport Security -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<!-- Allow Metro bundler in dev -->
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<false/>
	<key>UILaunchStoryboardName</key>
	<string>SplashScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
