{
  "name": "@ankrshield/mobile-ios",
  "version": "1.7.7",
  "private": true,
  "description": "ankrshield mobile app for iOS (React Native)",
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
