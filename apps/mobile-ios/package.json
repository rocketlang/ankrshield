    "@react-native/typescript-config": "^0.73.1",
    "@types/react": "^18.2.46",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
