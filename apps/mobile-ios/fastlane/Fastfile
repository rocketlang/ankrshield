## Fastfile — AnkrShield Android + iOS deployment
##
## Usage:
##   bundle exec fastlane android build          # unsigned debug APK
##   bundle exec fastlane android release        # signed release APK (needs KEYSTORE_* env)
##   bundle exec fastlane android deploy         # release + upload to Play Store (needs SUPPLY_JSON_KEY_PATH)
##   bundle exec fastlane android beta           # upload to internal testing track
##   bundle exec fastlane android whitelabel partner:bsnl  # white-label build

default_platform(:android)

PACKAGE_NAME    = "com.ankr.shield"
VERSION_NAME    = "1.3.3"
VERSION_CODE    = 133

platform :android do

  # ── Build (debug) ───────────────────────────────────────────────────────────
  lane :build do
    gradle(
      task:              "assemble",
      build_type:        "Debug",
      project_dir:       "android/",
      print_command:     false,
    )
    UI.success("Debug APK built: #{lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]}")
  end

  # ── Release (signed) ────────────────────────────────────────────────────────
  lane :release do
    UI.user_error!("Set KEYSTORE_PATH env var") unless ENV["KEYSTORE_PATH"]
    UI.user_error!("Set KEYSTORE_PASS env var") unless ENV["KEYSTORE_PASS"]
    UI.user_error!("Set KEYSTORE_ALIAS env var") unless ENV["KEYSTORE_ALIAS"]

    gradle(
      task:              "bundle",        # AAB for Play Store
      build_type:        "Release",
      project_dir:       "android/",
      properties: {
        "android.injected.signing.store.file"     => ENV["KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASS"],
        "android.injected.signing.key.alias"      => ENV["KEYSTORE_ALIAS"],
        "android.injected.signing.key.password"   => ENV["KEYSTORE_PASS"],
      },
    )
    UI.success("Release AAB: #{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]}")
  end

  # ── Deploy to Play Store (production track) ──────────────────────────────────
  lane :deploy do
    release         # build signed AAB first
    supply(
      package_name:       PACKAGE_NAME,
      track:              "production",
      release_status:     "draft",        # review before publishing
      metadata_path:      "fastlane/metadata/android",
      aab:                lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
    UI.success("Uploaded to Play Store production track (draft). Review at play.google.com/console")
  end

  # ── Beta (internal testing track) ─────────────────────────────────────────────
  lane :beta do
    release
    supply(
      package_name:   PACKAGE_NAME,
      track:          "internal",
      aab:            lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      metadata_path:  "fastlane/metadata/android",
    )
    slack(
      message:        "AnkrShield v#{VERSION_NAME} (#{VERSION_CODE}) uploaded to Play Store internal track ✅",
      slack_url:      ENV["SLACK_WEBHOOK_URL"] || "",
    ) if ENV["SLACK_WEBHOOK_URL"]
  end

  # ── White-label build ──────────────────────────────────────────────────────────
  lane :whitelabel do |options|
    partner = options[:partner] || UI.input("Partner name (bsnl/airtel/sbi):")
    sh("../scripts/build-whitelabel.sh --partner #{partner} --variant release")
    UI.success("White-label APK built for partner: #{partner}")
  end

  # ── Screenshot automation ──────────────────────────────────────────────────────
  lane :screenshots do
    UI.message("Run: npx playwright test --grep screenshot")
    UI.message("Screenshots should be placed in fastlane/metadata/android/en-US/images/phoneScreenshots/")
  end

end

platform :ios do

  # ── Build iOS (requires macOS + Xcode) ────────────────────────────────────────
  lane :build do
    cocoapods(podfile: "ios/Podfile", use_bundle_exec: true)
    gym(
      scheme:          "AnkrShield",
      workspace:       "ios/AnkrShield.xcworkspace",
      configuration:   "Debug",
      export_method:   "development",
      output_name:     "AnkrShield-debug.ipa",
    )
  end

  lane :release do
    cocoapods(podfile: "ios/Podfile", use_bundle_exec: true)
    gym(
      scheme:          "AnkrShield",
      workspace:       "ios/AnkrShield.xcworkspace",
      configuration:   "Release",
      export_method:   "app-store",
      output_name:     "AnkrShield.ipa",
    )
  end

  lane :beta do
    release
    pilot(
      app_identifier:  "com.ankr.shield",
      ipa:             "AnkrShield.ipa",
      groups:          ["AnkrShield Beta Testers"],
      notify_external_testers: false,
      changelog:       File.read("fastlane/metadata/android/en-US/changelogs/133.txt"),
    )
  end

end
