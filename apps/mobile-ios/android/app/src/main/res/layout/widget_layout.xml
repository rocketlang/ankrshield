<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_layout.xml — ShieldStatusWidget (2×1 home screen widget)
  Dark theme: bg #0a0a0a, score colour-coded green/yellow/red, accent #06b6d4
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:clickable="true">

    <!-- Shield icon (uses app launcher icon as a simple visual anchor) -->
    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="xShield"
        android:scaleType="fitCenter"/>

    <!-- Privacy Score — large, colour-coded -->
    <TextView
        android:id="@+id/widget_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_icon"
        android:layout_marginStart="10dp"
        android:layout_alignTop="@id/widget_icon"
        android:text="--"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#22c55e"
        android:includeFontPadding="false"/>

    <!-- "threats blocked today" sub-line -->
    <TextView
        android:id="@+id/widget_threats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_icon"
        android:layout_marginStart="10dp"
        android:layout_below="@id/widget_score"
        android:layout_marginTop="2dp"
        android:text="0 threats blocked today"
        android:textSize="11sp"
        android:textColor="#94a3b8"/>

    <!-- "Privacy Score" label above the number -->
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:text="Privacy Score"
        android:textSize="9sp"
        android:textColor="#475569"
        android:textAllCaps="true"
        android:letterSpacing="0.06"/>

</RelativeLayout>
