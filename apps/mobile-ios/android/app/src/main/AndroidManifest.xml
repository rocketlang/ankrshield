<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.BIND_VPN_SERVICE"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <!-- WhatsApp Guard — media scanning (requested at runtime, not at install) -->
  <!-- Android 13+ granular media permissions -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
  <!-- Android 12 and below — scoped to SDK 32 to avoid conflict with granular perms on 13+ -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <!-- Android 14+ requires explicit foreground service type permission -->
  <!-- Android 13+ — runtime permission for posting notifications -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.READ_CONTACTS"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <!-- Anti-Theft — last-known location (does not start GPS, reads cached fix only) -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <!-- A10 — WhatsApp OTP Guard: receive SMS to detect hijack attempts -->
  <uses-permission android:name="android.permission.RECEIVE_SMS"/>
  <!-- A12 — SIM Swap Detector: read SIM ICCID to detect swap events -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
  <!-- A10 — Full-screen intent for CRITICAL OTP hijack overlay -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
  <!-- A11 — WorkManager background work -->
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_SDK_VERSION" android:value="50.0.0"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="com.ankr.shield"/>
      </intent-filter>
      <!-- UPI deep link handler — opens UpiGuard when user taps a upi:// link -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="upi"/>
      </intent-filter>
      <!-- Share target — opens LinkScanner when user shares a URL from any app -->
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="text/plain"/>
      </intent-filter>
    </activity>
    <activity android:name="com.facebook.react.devsupport.DevSettingsActivity" android:exported="false"/>

    <!-- AnkrShield DNS VPN Service -->
    <service
      android:name=".DnsVpnService"
      android:permission="android.permission.BIND_VPN_SERVICE"
      android:exported="false">
      <intent-filter>
        <action android:name="android.net.VpnService"/>
      </intent-filter>
    </service>

    <!-- WhatsApp Attachment Guard (foreground file watcher)
         NO foregroundServiceType — plain FGS avoids Android 14 crash (no dataSync) -->
    <service
      android:name=".WhatsAppGuardService"
      android:exported="false"/>

    <!-- Boot receiver — restarts WhatsApp Guard after device reboot -->
    <receiver
      android:name=".BootReceiver"
      android:exported="true">
      <intent-filter android:priority="1000">
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
      </intent-filter>
    </receiver>

    <!-- Threat action receiver — handles "Delete Now" from notifications -->
    <receiver
      android:name=".ThreatActionReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="com.ankr.shield.ACTION_DELETE_THREAT"/>
      </intent-filter>
    </receiver>

    <!-- xShield Quick Settings Tile (Android 7+) -->
    <service
      android:name=".QuickShieldTile"
      android:label="xShield Protection"
      android:icon="@mipmap/ic_launcher"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE"/>
      </intent-filter>
    </service>

    <!-- xShield persistent foreground notification — plain FGS, NO foregroundServiceType -->
    <service
      android:name=".ShieldNotificationService"
      android:exported="false">
    </service>

    <!-- Ransomware file-system watcher — plain FGS, no foregroundServiceType (Android 14 safe) -->
    <service
      android:name=".RansomwareWatcherService"
      android:exported="false">
    </service>

    <!-- AnkrShield Accessibility Service — monitors browser URL bar for phishing -->
    <service
      android:name=".AnkrShieldAccessibilityService"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService"/>
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config"/>
    </service>

    <!-- AnkrShield Device Admin Receiver — enables lock + wipe (anti-theft) -->
    <receiver
      android:name=".AnkrShieldAdminReceiver"
      android:permission="android.permission.BIND_DEVICE_ADMIN"
      android:exported="true">
      <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/device_admin"/>
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
      </intent-filter>
    </receiver>

    <!-- A10 — WhatsApp OTP Guard BroadcastReceiver -->
    <receiver
      android:name=".OtpGuardReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter android:priority="999">
        <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
      </intent-filter>
    </receiver>

    <!-- A10 — OTP Guard dismiss receiver (user taps "I'm Safe") -->
    <receiver
      android:name=".OtpGuardDismissReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="com.ankr.shield.ACTION_OTP_GUARD_DISMISS"/>
      </intent-filter>
    </receiver>

    <!-- Shield Status home screen widget -->
    <receiver
      android:name=".ShieldStatusWidget"
      android:exported="true"
      android:label="xShield Status">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/shield_widget_info"/>
    </receiver>

  </application>
</manifest>