# Copy this file to keystore.properties and fill in your release signing credentials.
# NEVER commit keystore.properties to git — it is in .gitignore.
#
# Generate a new keystore:
#   keytool -genkey -v -keystore ankrshield-release.keystore \
#           -alias ankrshield -keyalg RSA -keysize 2048 -validity 10000
#
# Then copy the keystore file into android/app/ and set the values below.

storeFile=ankrshield-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=ankrshield
keyPassword=YOUR_KEY_PASSWORD
